# ── Server ────────────────────────────────────────────────────────────────────
PORT=3101

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://codigos:changeme@localhost:5432/codigos

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public-facing API base (used in email links & payment webhook URLs)
API_BASE_URL=https://codigosdemujeres.com
# Frontend origin (used in CORS + ePayco response redirect)
CLIENT_URL=https://codigosdemujeres.com

# ── Admin ─────────────────────────────────────────────────────────────────────
# Secret token for GET /api/store/admin/orders  (generate: openssl rand -hex 32)
ADMIN_TOKEN=replace-with-a-strong-random-token

# ── SMTP (email delivery) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@codigosdemujeres.com
SMTP_PASS=your-smtp-password
# Defaults to SMTP_USER if not set
SMTP_FROM=CÓDIGOS <hello@codigosdemujeres.com>

# ── ePayco (card payments) ────────────────────────────────────────────────────
# https://dashboard.epayco.co → Cuenta → API Keys
EPAYCO_CLIENT_ID=your-epayco-client-id
EPAYCO_PUBLIC_KEY=your-epayco-public-key
EPAYCO_PRIVATE_KEY=your-epayco-private-key
# Set to "true" for sandbox / test mode
EPAYCO_TEST_MODE=true
# Webhook signature validation — dashboard.epayco.co → Cuenta → Datos de integración
# P_CUST_ID_CLIENTE and P_KEY (different from the API keys above)
EPAYCO_P_CUST_ID=your-p-cust-id
EPAYCO_P_KEY=your-p-key
# Optional: override the USD→COP exchange rate (used as fallback if API is unreachable)
EPAYCO_USD_TO_COP_RATE=4200

# ── Daimo Pay (crypto / USDT payments) ───────────────────────────────────────
# https://pay.daimo.com → Dashboard → API Keys
DAIMO_API_KEY=your-daimo-api-key
# Webhook signing secret from Daimo dashboard
DAIMO_WEBHOOK_SECRET=your-daimo-webhook-secret

# ── Digital product CDN URLs ──────────────────────────────────────────────────
# Direct download links for each format (must be pre-signed / access-controlled)
BOOK_EBOOK_CDN_URL=https://cdn.codigosdemujeres.com/codigos-ebook.zip
BOOK_AUDIO_CDN_URL=https://cdn.codigosdemujeres.com/codigos-audio.zip
BOOK_BUNDLE_CDN_URL=https://cdn.codigosdemujeres.com/codigos-bundle.zip

# ── Free sample ───────────────────────────────────────────────────────────────
# Direct URL to the free sample PDF (leave empty to disable the button)
BOOK_SAMPLE_URL=https://cdn.codigosdemujeres.com/codigos-sample.pdf

# ── Notion (Project Management) ──────────────────────────────────────────────
# Internal integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...
# Root page ID where all project Notion pages live (from the page URL)
NOTION_ROOT_PAGE_ID=
# Optional: pre-created database IDs (created automatically if empty)
NOTION_ROADMAP_DB_ID=
NOTION_REPORTS_DB_ID=
NOTION_GOALS_DB_ID=
