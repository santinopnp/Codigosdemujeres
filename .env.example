# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/codigos

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3101
API_BASE_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com
ADMIN_TOKEN=change-me-to-a-random-secret

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=CÓDIGOS <noreply@yourdomain.com>

# ── ePayco ────────────────────────────────────────────────────────────────────
EPAYCO_CLIENT_ID=
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_TEST=true

# ── Daimo Pay ─────────────────────────────────────────────────────────────────
DAIMO_API_KEY=
DAIMO_WEBHOOK_SECRET=

# ── CDN download URLs ─────────────────────────────────────────────────────────
BOOK_EBOOK_CDN_URL=https://cdn.yourdomain.com/codigos-ebook.pdf
BOOK_AUDIO_CDN_URL=https://cdn.yourdomain.com/codigos-audio.zip
BOOK_BUNDLE_CDN_URL=https://cdn.yourdomain.com/codigos-bundle.zip
